<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Berat Badan (kg)"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etBeratBadan"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_input"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:hint="Contoh: 70"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tinggi Badan (cm)"
            android:textStyle="bold"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="8dp"/>

        <EditText
            android:id="@+id/etTinggiBadan"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:background="@drawable/bg_input"
            android:inputType="numberDecimal"
            android:paddingHorizontal="16dp"
            android:hint="Contoh: 170"
            android:textColor="@color/colorTextPrimary"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnHitung"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Hitung BMI"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/colorButtonPurple"
            app:icon="@android:drawable/ic_menu_agenda"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReset"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Reset"
            android:textAllCaps="false"
            android:textColor="@color/colorButtonBlue"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:strokeColor="@color/colorButtonBlue"
            app:strokeWidth="1dp"
            app:icon="@android:drawable/ic_popup_sync"
            app:iconTint="@color/colorButtonBlue"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnKategori"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Lihat Kategori"
            android:textAllCaps="false"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:backgroundTint="@color/colorButtonGreen"
            app:icon="@android:drawable/ic_menu_sort_by_size"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHasil"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/colorInputBackground"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hasil BMI"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"/>

                <TextView
                    android:id="@+id/tvHasilAngka"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0.0"
                    android:textSize="42sp"
                    android:textStyle="bold"
                    android:textColor="@color/colorTextPrimary"
                    android:layout_marginVertical="8dp"/>

                <TextView
                    android:id="@+id/tvKategoriStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Status"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_badge_normal"
                    android:paddingHorizontal="24dp"
                    android:paddingVertical="6dp"
                    android:textStyle="bold"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>